{
  "name": "@voucher/frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "EC-VoucherHub frontend and deterministic UI design preview",
  "scripts": {
    "dev": "vite",
    "dev:design": "VITE_DESIGN_PREVIEW=true vite",
    "dev:local": "vite preview",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "5.59.16",
    "@voucher/shared": "*",
    "axios": "^1.20.0",
    "i18next": "23.16.5",
    "lucide-react": "^1.33.0",
    "qr-scanner": "^1.4.2",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "15.1.1",
    "react-router-dom": "^6.30.6",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.0.1",
    "@types/qrcode": "1.5.5",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "jsdom": "25.0.1",
    "typescript": "^5.7.0",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
