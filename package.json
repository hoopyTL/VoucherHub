{
  "name": "ec-voucherhub",
  "version": "1.0.0",
  "private": true,
  "description": "Hệ thống thương mại điện tử bán voucher giảm giá trực tuyến",
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspace=shared && npm run build --workspace=backend && npm run build --workspace=frontend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "tv4:verify": "node scripts/verify-tv4.mjs",
    "db:migrate": "npm run db:migrate --workspace=backend",
    "db:generate": "npm run db:generate --workspace=backend",
    "db:seed": "npm run db:seed --workspace=backend",
    "db:seed:full": "npm run db:seed:full --workspace=backend",
    "prepare": "husky",
    "audit:policy": "node scripts/audit-policy.mjs",
    "test:tooling": "node --test scripts/*.test.mjs"
  },
  "lint-staged": {
    "**/*.{js,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": "22.x",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "ecommerce",
    "voucher",
    "monorepo"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.62.1",
    "@prisma/client": "^6.19.3",
    "@types/node": "^25.9.2",
    "bcryptjs": "^3.0.3",
    "concurrently": "^10.0.4",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.4",
    "rimraf": "^5.0.10",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.61.0"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "^1.2.4",
    "@rollup/rollup-linux-x64-gnu": "^4.62.4"
  }
}
